{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Shared settings. Always deploy with an environment:
  //   npx wrangler deploy --env npbeauty | --env lemonbeauty
  "name": "product-catalog",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Secret API_SECRET is set per environment (never commit):
  //   npx wrangler secret put API_SECRET --env <shop>
  "env": {
    "npbeauty": {
      // https://npbeauty.ethermorph-corp.workers.dev
      "name": "npbeauty",
      "vars": {
        // GAS web app /exec URL of the NPBeauty sheet
        "GAS_URL": "https://script.google.com/macros/s/AKfycbyfMCb5m-TTBWT2NykhvyjvhGOktfumfKx6M_2sDLb25ATRDR4AHX-9EvyFZgsFJPl1-A/exec"
      },
      // KV id — filled in Phase 5
      "kv_namespaces": [{ "binding": "CATALOG", "id": "REPLACE_WITH_NPBEAUTY_KV_ID" }]
    },
    "lemonbeauty": {
      // https://lemonbeauty.ethermorph-corp.workers.dev
      "name": "lemonbeauty",
      "vars": {
        // GAS web app /exec URL of the LemonBeauty sheet
        "GAS_URL": "https://script.google.com/macros/s/AKfycbzGSVAOM_Kd6ueNRJE3yVdnK6ZHqLo7tgOA05WXxm6W3oQ253bn4kDtiJSAVOeQ1E8e/exec"
      },
      "kv_namespaces": [{ "binding": "CATALOG", "id": "REPLACE_WITH_LEMONBEAUTY_KV_ID" }]
    }
  }
}
